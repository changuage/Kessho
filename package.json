{
  "name": "deterministic-generative-music",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run core:product:wasm && tsc && vite build",
    "test:preset-metadata": "node scripts/run-preset-metadata-regression.mjs",
    "test:preset-dedup": "node scripts/run-preset-dedup-regression.mjs",
    "test:dynamics-character": "node scripts/check-dynamics-character-wasm.mjs",
    "test:native-swift-dynamics-parity": "node scripts/check-native-swift-dynamics-parity.mjs",
    "test:native-swift-shared-reverb": "node scripts/check-native-swift-shared-reverb.mjs",
    "test:native-swift-midi-threading": "node scripts/check-native-swift-midi-threading.mjs",
    "test:native-swift-supabase-parity": "node scripts/check-native-swift-supabase-parity.mjs",
    "test:native-swift-granular-parity": "node scripts/check-native-swift-granular-parity.mjs",
    "test:native-swift-mobile-hotpaths": "node scripts/check-native-swift-mobile-audio-hotpaths.mjs",
    "test:native-swift-state-parity": "node scripts/check-native-swift-state-parity.mjs",
    "test:native-swift-universal-layout": "node scripts/check-native-swift-universal-layout.mjs",
    "test:mobile-web-hotpaths": "node scripts/check-mobile-web-hotpaths.mjs",
    "audit:preset-v2": "node scripts/audit-supabase-presets-v2.mjs",
    "repair:preset-child-graphs": "node scripts/repair-new-engine-cloud-presets.mjs",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "clean:local": "node scripts/clean-local-generated.mjs",
    "check:mac": "bash scripts/check-macos.sh",
    "cap:sync:ios": "npm run build && npx cap sync ios",
    "cap:open:ios": "npx cap open ios",
    "cap:mac:build": "node scripts/build-capacitor-mac.mjs",
    "cap:mac:open": "npm run cap:mac:build && open \"build/macos/Kessho Capacitor.app\"",
    "core:test": "node scripts/test-kessho-core.mjs",
    "core:build:wasm": "node scripts/build-kessho-core-wasm.mjs",
    "core:snapshot": "node scripts/check-core-snapshot-contract.mjs",
    "core:host": "node scripts/check-core-engine-host.mjs",
    "core:midi": "node scripts/check-core-midi-events.mjs",
    "core:browser-sonic-parity": "node scripts/check-web-core-sonic-parity.mjs --manual-note=pad1:60:0.82:900 --duration-ms=1600 --settle-ms=200 --max-lag-ms=250 --min-lag-correlation=0.75 --rms-tolerance=0.2",
    "core:product:generate": "node scripts/generate-kessho-product-bindings.mjs",
    "core:product:schema": "node scripts/check-kessho-product-schema.mjs",
    "core:product:workflow": "node scripts/check-kessho-product-workflow.mjs",
    "core:product:architecture": "node scripts/check-kessho-product-architecture-boundaries.mjs",
    "core:product:patch-bridges": "node scripts/check-kessho-product-patch-bridges.mjs",
    "core:product:snapshot-authority": "node scripts/check-kessho-product-snapshot-authority.mjs",
    "core:product:host-reconciliation": "node scripts/check-kessho-product-host-reconciliation.mjs",
    "core:product:dirty-diff": "node scripts/check-kessho-product-dirty-diff-classification.mjs",
    "core:product:runtime-fallbacks": "node scripts/check-kessho-product-runtime-fallbacks.mjs",
    "core:product:getter-policies": "node scripts/check-kessho-product-getter-policies.mjs",
    "core:product:reference-isolation": "node scripts/check-kessho-product-reference-isolation.mjs",
    "core:product:param-accounting": "node scripts/check-kessho-product-param-accounting.mjs",
    "core:product:sequencer": "node scripts/check-kessho-product-sequencer-events.mjs",
    "core:product:harmony": "node scripts/check-kessho-product-harmony.mjs",
    "core:product:determinism": "node scripts/check-kessho-product-deterministic-music.mjs",
    "core:product:graph": "node scripts/check-kessho-product-graph.mjs",
    "core:product:fx": "node scripts/check-kessho-product-fx-routing.mjs",
    "core:product:fx-depth": "node scripts/check-kessho-product-fx-master-depth.mjs",
    "core:product:asset-manifest": "node scripts/check-kessho-product-asset-manifest.mjs",
    "core:product:sources": "node scripts/check-kessho-product-source-wrappers.mjs",
    "core:product:assets": "node scripts/check-kessho-product-assets.mjs",
    "core:product:source-parity": "node scripts/check-kessho-product-source-parity-broadening.mjs",
    "core:product:web-graph-parity:audit": "node scripts/check-kessho-product-web-graph-parity.mjs",
    "core:product:web-graph-parity:strict": "node scripts/check-kessho-product-web-graph-parity.mjs --strict",
    "core:product:web-graph-capture-smoke": "node scripts/check-kessho-product-web-graph-capture-smoke.mjs",
    "core:product:web-graph-capture-smoke:fast": "node scripts/check-kessho-product-web-graph-capture-smoke.mjs --tier=fast",
    "core:product:web-graph-capture-smoke:full": "node scripts/check-kessho-product-web-graph-capture-smoke.mjs",
    "core:product:web-master-corpus": "node scripts/check-kessho-product-web-master-corpus.mjs",
    "core:product:web-master-corpus:full": "node scripts/check-kessho-product-web-master-corpus.mjs",
    "core:product:abi": "node scripts/run-kessho-product-cpp-test.mjs ProductAbiLayoutTests",
    "core:product:web-host": "node scripts/check-kessho-product-web-host.mjs",
    "core:product:browser-runtime": "node scripts/check-kessho-product-browser-runtime.mjs",
    "core:product:native": "node scripts/check-kessho-product-native-bridge.mjs",
    "core:product:native-release": "node scripts/check-kessho-product-native-release-proof.mjs",
    "core:product:native-build": "swift build --package-path KesshoNativeSwift",
    "core:product:native-release-smoke": "swift run --package-path KesshoNativeSwift KesshoProductNativeReleaseSmoke",
    "core:product:default-gate-v3": "node scripts/check-kessho-product-default-gate-v3.mjs",
    "core:product:cpu": "node scripts/check-kessho-product-cpu-budget.mjs",
    "core:product:wasm": "node scripts/check-kessho-product-wasm.mjs",
    "core:product:ci:prereqs": "node scripts/run-kessho-product-ci.mjs --skip-final-gate",
    "core:product:ci": "node scripts/run-kessho-product-ci.mjs"
  },
  "dependencies": {
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@kessho/capacitor-audio-session": "file:plugins/kessho-capacitor-audio-session",
    "@kessho/capacitor-midi-routing": "file:plugins/kessho-capacitor-midi-routing",
    "@supabase/supabase-js": "^2.93.3",
    "jszip": "^3.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "playwright": "^1.59.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
}

{
  "name": "deterministic-generative-music",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:preset-metadata": "node scripts/run-preset-metadata-regression.mjs",
    "test:preset-dedup": "node scripts/run-preset-dedup-regression.mjs",
    "test:dynamics-character": "node scripts/check-dynamics-character-wasm.mjs",
    "test:dynamics-parity": "node scripts/check-dynamics-parity.mjs",
    "test:native-shared-reverb": "node scripts/check-native-shared-reverb.mjs",
    "test:native-midi-threading": "node scripts/check-native-midi-threading.mjs",
    "test:native-supabase-parity": "node scripts/check-native-supabase-parity.mjs",
    "test:native-granular-parity": "node scripts/check-native-granular-parity.mjs",
    "test:ios-mobile-hotpaths": "node scripts/check-ios-mobile-audio-hotpaths.mjs",
    "test:ios-state-parity": "node scripts/check-ios-state-parity.mjs",
    "test:ios-universal-layout": "node scripts/check-ios-universal-layout.mjs",
    "test:mobile-web-hotpaths": "node scripts/check-mobile-web-hotpaths.mjs",
    "audit:preset-v2": "node scripts/audit-supabase-presets-v2.mjs",
    "repair:preset-child-graphs": "node scripts/repair-new-engine-cloud-presets.mjs",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "check:mac": "bash scripts/check-macos.sh",
    "cap:sync:ios": "npm run build && npx cap sync ios",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@kessho/capacitor-background-audio-spike": "file:plugins/kessho-background-audio-spike",
    "@supabase/supabase-js": "^2.93.3",
    "jszip": "^3.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
}

{
  "name": "deterministic-generative-music",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:preset-metadata": "node scripts/run-preset-metadata-regression.mjs",
    "test:preset-dedup": "node scripts/run-preset-dedup-regression.mjs",
    "test:dynamics-character": "node scripts/check-dynamics-character-wasm.mjs",
    "test:native-swift-dynamics-parity": "node scripts/check-native-swift-dynamics-parity.mjs",
    "test:native-swift-shared-reverb": "node scripts/check-native-swift-shared-reverb.mjs",
    "test:native-swift-midi-threading": "node scripts/check-native-swift-midi-threading.mjs",
    "test:native-swift-supabase-parity": "node scripts/check-native-swift-supabase-parity.mjs",
    "test:native-swift-granular-parity": "node scripts/check-native-swift-granular-parity.mjs",
    "test:native-swift-mobile-hotpaths": "node scripts/check-native-swift-mobile-audio-hotpaths.mjs",
    "test:native-swift-state-parity": "node scripts/check-native-swift-state-parity.mjs",
    "test:native-swift-universal-layout": "node scripts/check-native-swift-universal-layout.mjs",
    "test:mobile-web-hotpaths": "node scripts/check-mobile-web-hotpaths.mjs",
    "audit:preset-v2": "node scripts/audit-supabase-presets-v2.mjs",
    "repair:preset-child-graphs": "node scripts/repair-new-engine-cloud-presets.mjs",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "clean:local": "node scripts/clean-local-generated.mjs",
    "check:mac": "bash scripts/check-macos.sh",
    "cap:sync:ios": "npm run build && npx cap sync ios",
    "cap:open:ios": "npx cap open ios",
    "cap:mac:build": "node scripts/build-capacitor-mac.mjs",
    "cap:mac:open": "npm run cap:mac:build && open \"build/macos/Kessho Capacitor.app\"",
    "core:test": "node scripts/test-kessho-core.mjs",
    "core:build:wasm": "node scripts/build-kessho-core-wasm.mjs",
    "core:parity": "node scripts/check-kessho-core-render-parity.mjs",
    "core:snapshot": "node scripts/check-core-snapshot-contract.mjs",
    "core:host": "node scripts/check-core-engine-host.mjs",
    "core:midi": "node scripts/check-core-midi-events.mjs",
    "core:module-parity": "node scripts/check-kessho-core-dynamics-module-parity.mjs",
    "core:reverb-module-parity": "node scripts/check-kessho-core-reverb-module-parity.mjs",
    "core:granular-module-parity": "node scripts/check-kessho-core-granular-module-parity.mjs",
    "core:spectral-freeze-module-parity": "node scripts/check-kessho-core-spectral-freeze-module-parity.mjs",
    "core:lead-fm-module-parity": "node scripts/check-kessho-core-lead-fm-module-parity.mjs",
    "core:pad-module-parity": "node scripts/check-kessho-core-pad-module-parity.mjs",
    "core:drum-module-parity": "node scripts/check-kessho-core-drum-module-parity.mjs",
    "core:soundscapes-module-parity": "node scripts/check-kessho-core-soundscapes-module-parity.mjs",
    "core:delay-a-module-regression": "node scripts/check-kessho-core-delay-a-module-regression.mjs",
    "core:delay-b-module-regression": "node scripts/check-kessho-core-delay-b-module-regression.mjs",
    "core:web-module": "node scripts/check-kessho-core-web-module-preview.mjs",
    "core:browser-sonic-parity": "node scripts/check-web-core-sonic-parity.mjs",
    "core:golden-profile": "node scripts/profile-kessho-core-golden-candidates.mjs",
    "core:readiness": "node scripts/check-kessho-core-parity-readiness.mjs",
    "core:readiness:browser": "node scripts/check-kessho-core-parity-readiness.mjs --browser-corpus",
    "core:ci": "npm run core:build:wasm && npm run core:snapshot && npm run core:midi && npm run core:host && npm run core:test && npm run core:parity && npm run core:module-parity && npm run core:reverb-module-parity && npm run core:granular-module-parity && npm run core:spectral-freeze-module-parity && npm run core:lead-fm-module-parity && npm run core:pad-module-parity && npm run core:drum-module-parity && npm run core:soundscapes-module-parity && npm run core:delay-a-module-regression && npm run core:delay-b-module-regression && npm run core:web-module"
  },
  "dependencies": {
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@kessho/capacitor-audio-session": "file:plugins/kessho-capacitor-audio-session",
    "@kessho/capacitor-midi-routing": "file:plugins/kessho-capacitor-midi-routing",
    "@supabase/supabase-js": "^2.93.3",
    "jszip": "^3.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "playwright": "^1.59.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
}

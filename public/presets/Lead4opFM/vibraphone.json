{
  "id": "vibraphone",
  "name": "Vibraphone",
  "engine": "Lead4opFM",
  "method": "new",
  "operators": 4,
  "algorithm": "stack",
  "_notes": "Stack: serial FM chain. Vibraphone has harmonic partials (ratio 4). LFO on pitch = motor vibrato. Long FM for the sustain ring.",
  "xy": {
    "xLevel": 1,
    "xPan": -0.32,
    "yLevel": 0.95,
    "yPan": 0.32
  },
  "params": {
    "beatDetune": 2,
    "carrier2Mix": 0.35,
    "mod1": {
      "ratio": 4,
      "index": 3.5,
      "decay": 1.5,
      "sustain": 0.1
    },
    "mod2": {
      "ratio": 10,
      "index": 1.5,
      "decay": 0.3
    },
    "mod3": {
      "ratio": 20,
      "index": 0,
      "decay": 0.5
    },
    "mod4": {
      "ratio": 0.5,
      "index": 0,
      "decay": 0.5
    },
    "lfo": {
      "rate": 4.5,
      "depth": 0.15,
      "target": "pitch"
    },
    "envelope": {
      "attack": 0.002,
      "decay": 1.0,
      "sustain": 0.2,
      "release": 3.0
    },
    "filter": {
      "freq": 6000,
      "q": 0.5
    },
    "transient": {
      "click": 0.15,
      "noise": 0.04,
      "duration": 12,
      "decay": 100,
      "filter": 4000,
      "type": "filtered"
    },
    "gain": 0.65
  }
}
